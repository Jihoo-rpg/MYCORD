{
  "name": "mycord",
  "version": "1.0.0",
  "description": "Mycord - 친구들과 대화하는 채팅 앱",
  "main": "main.js",
  "author": "Mycord",
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "33.2.0",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.mycord.app",
    "productName": "Mycord",
    "files": [
      "main.js",
      "app.html"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Mycord-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.social-networking",
      "artifactName": "Mycord.${ext}"
    }
  }
}